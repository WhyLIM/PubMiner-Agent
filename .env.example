# --- 数据库 ---
# 生产：postgresql://user:pass@host/pubminer ；本地默认 SQLite
PUBMINER_DB_URL=sqlite:///./pubminer_ea.db

# --- NCBI（检索/水合/resolver 必需）---
PUBMED_EMAIL=you@example.com
PUBMED_API_KEY=

# --- LLM ---
# 协议优先级：PUBMINER_LLM_PROTOCOL=auto（默认）时按
#   Responses API -> Anthropic Messages -> Chat Completions
# 运行时探测并粘住首个可用协议；也可固定为 responses|anthropic|completions。
#
# 各厂商参考（base_url 决定探测路径 /responses、/v1/messages、/chat/completions）：
#   智谱 GLM:      https://open.bigmodel.cn/api/paas/v4      (responses ✓ / anthropic: https://open.bigmodel.cn/api/anthropic)
#   DeepSeek:      https://api.deepseek.com                  (responses ✓，V4 起)
#   OpenAI:        https://api.openai.com/v1                 (responses ✓)
#   Moonshot Kimi: https://api.moonshot.ai/v1                (responses ✓ / anthropic ✓)
#   MiniMax:       https://api.minimax.io/anthropic          (anthropic ✓)
#   Anthropic:     https://api.anthropic.com                 (anthropic ✓)
#   Gemini/Qwen 兼容层、旧网关: 各自兼容 base_url            (仅 completions)
PUBMINER_LLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4
PUBMINER_LLM_API_KEY=
PUBMINER_LLM_MODEL=glm-4-flash
PUBMINER_LLM_PROTOCOL=auto

# --- 可选 ---
PUBMINER_PMC_CACHE=./download/pmc_cache
PUBMINER_PROMPTS_DIR=
PUBMINER_HOST=127.0.0.1
PUBMINER_PORT=8001
