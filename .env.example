# --- 数据库 ---
# 生产：postgresql://user:pass@host/pubminer ；本地默认 SQLite
PUBMINER_DB_URL=sqlite:///./pubminer_ea.db

# --- NCBI（检索/水合/resolver 必需）---
PUBMED_EMAIL=you@example.com
PUBMED_API_KEY=

# --- LLM（OpenAI 兼容端点）---
# 智谱: https://open.bigmodel.cn/api/paas/v4  模型 glm-4-flash
# DeepSeek: https://api.deepseek.com/v1       模型 deepseek-chat
# OpenAI: https://api.openai.com/v1           模型 gpt-4o-mini
PUBMINER_LLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4
PUBMINER_LLM_API_KEY=
PUBMINER_LLM_MODEL=glm-4-flash

# --- 可选 ---
PUBMINER_PMC_CACHE=./download/pmc_cache
PUBMINER_PROMPTS_DIR=
PUBMINER_HOST=127.0.0.1
PUBMINER_PORT=8001
