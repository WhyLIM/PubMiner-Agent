# --- 数据库 ---
# 生产：postgresql://user:pass@host/pubminer ；本地默认 SQLite
PUBMINER_DB_URL=sqlite:///./pubminer_ea.db

# --- NCBI（检索/水合/resolver 必需）---
PUBMED_EMAIL=you@example.com
PUBMED_API_KEY=

# --- LLM ---
# 供应商（注册表内置于代码）：zhipu | zhipu-coding | zai | deepseek | openai |
#   anthropic | moonshot | minimax | qwen | custom
# base url 已按供应商内置（各协议端点不同），一般无需填写；
# PUBMINER_LLM_BASE_URL 仅作为覆盖（vendor=custom 时必需）。
# 模型留空时使用供应商默认模型。
PUBMINER_LLM_VENDOR=zhipu-coding
PUBMINER_LLM_API_KEY=
PUBMINER_LLM_MODEL=
# PUBMINER_LLM_BASE_URL=

# 协议优先级：auto（默认）按 Responses API -> Anthropic Messages -> Chat Completions
# 运行时探测并粘住首个可用协议；可固定为 responses|anthropic|completions
PUBMINER_LLM_PROTOCOL=auto

# 思考模式（按厂商官方参数自动映射）：
#   default = 厂商默认（不注入任何参数）
#   off     = 关闭思考。zhipu/moonshot -> thinking.disabled；
#             qwen -> enable_thinking=false；openai -> reasoning_effort=minimal
#   on      = 开启思考。zhipu/moonshot -> thinking.enabled；
#             qwen -> enable_thinking=true；openai -> reasoning_effort=medium；
#             anthropic -> thinking.enabled + budget（temperature 自动移除）
# 注意：GLM 思考型模型跑 JSON 管线建议 off，否则思考会消耗输出预算
PUBMINER_LLM_THINKING=off
# PUBMINER_LLM_THINKING_BUDGET=4096   (anthropic on 时的 budget_tokens)

# --- 可选 ---
PUBMINER_PMC_CACHE=./download/pmc_cache
PUBMINER_PROMPTS_DIR=
PUBMINER_HOST=127.0.0.1
PUBMINER_PORT=8001

# --- Embedding（万级文献筛选预过滤）---
# 智谱 embedding-3 与 LLM 共用同一 API key 和 base URL
PUBMINER_EMBEDDING_MODEL=embedding-3
PUBMINER_EMBEDDING_DIMENSIONS=2048
